85410","type":"DERIVED","citation":"Etropolski M, Kuperwasser B, Flugel M, Haufel T, Lange B, Rauschkolb C, Laschewski F. Safety and tolerability of tapentadol extended release in moderate to severe chronic osteoarthritis or low back pain management: pooled analysis of randomized controlled trials. Adv Ther. 2014 Jun;31(6):604-20. doi: 10.1007/s12325-014-0128-6. Epub 2014 Jul 2."},{"pmid":"23340531","type":"DERIVED","citation":"Afilalo M, Morlion B. Efficacy of tapentadol ER for managing moderate to severe chronic pain. Pain Physician. 2013 Jan;16(1):27-40."},{"pmid":"20602712","type":"DERIVED","citation":"Wild JE, Grond S, Kuperwasser B, Gilbert J, McCann B, Lange B, Steup A, Haufel T, Etropolski MS, Rauschkolb C, Lange R. Long-term safety and tolerability of tapentadol extended release for the management of chronic low back pain or osteoarthritis pain. Pain Pract. 2010 Sep-Oct;10(5):416-27. doi: 10.1111/j.1533-2500.2010.00397.x."}]}},"resultsSection":{"participantFlowModule":{"preAssignmentDetails":"In this study 1123 participants passed screening, 1121 participants were randomized (2 participants were not randomized in error) \\& 1117 participants received at least 1 dose of study medication (4 participants did not receive study medication)","recruitmentDetails":"The recruitment period for this out-patient, multicenter study occurred between 14 November 2006 \\& 25 July 2008.","groups":[{"id":"FG000","title":"Tapentadol (CG5503)","description":"Tapentadol (CG5503) extended release (ER) 100 to 250 mg twice daily (BID) for up to one year"},{"id":"FG001","title":"Oxycodone","description":"Oxycodone controlled release (CR) 20 to 50 mg twice daily (BID) for up to one year."}],"periods":[{"title":"Overall Study","milestones":[{"type":"STARTED","achievements":[{"groupId":"FG000","comment":"Number of participants who received at least 1 dose of study medication","numSubjects":"894"},{"groupId":"FG001","comment":"Number of participants who received at least 1 dose of study medication","numSubjects":"223"}]},{"type":"COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"413"},{"groupId":"FG001","numSubjects":"78"}]},{"type":"NOT COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"481"},{"groupId":"FG001","numSubjects":"145"}]}],"dropWithdraws":[{"type":"Withdrawal by Subject","reasons":[{"groupId":"FG000","numSubjects":"94"},{"groupId":"FG001","numSubjects":"31"}]},{"type":"Lost to Follow-up","reasons":[{"groupId":"FG000","numSubjects":"40"},{"groupId":"FG001","numSubjects":"7"}]},{"type":"Adverse Event","reasons":[{"groupId":"FG000","numSubjects":"203"},{"groupId":"FG001","numSubjects":"82"}]},{"type":"Lack of Efficacy","reasons":[{"groupId":"FG000","numSubjects":"72"},{"groupId":"FG001","numSubjects":"7"}]},{"type":"Resolution of Pain","reasons":[{"groupId":"FG000","numSubjects":"2"},{"groupId":"FG001","numSubjects":"0"}]},{"type":"Study medication non compliant","reasons":[{"groupId":"FG000","numSubjects":"42"},{"groupId":"FG001","numSubjects":"15"}]},{"type":"All other","reasons":[{"groupId":"FG000","numSubjects":"28"},{"groupId":"FG001","numSubjects":"3"}]}]}]},"baselineCharacteristicsModule":{"groups":[{"id":"BG000","title":"Tapentadol (CG5503)","description":"Tapentadol (CG5503) extended release (ER) 100 to 250mg twice daily (BID) for up to one year"},{"id":"BG001","title":"Oxycodone","description":"Oxycodone controlled release (CR) 20 to 50mg twice daily (BID) for up to one year."},{"id":"BG002","title":"Total","description":"Total of all reporting groups"}],"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"894"},{"groupId":"BG001","value":"223"},{"groupId":"BG002","value":"1117"}]}],"measures":[{"title":"Age, Categorical","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"<=18 years","measurements":[{"groupId":"BG000","value":"0"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"0"}]},{"title":"Between 18 and 65 years","measurements":[{"groupId":"BG000","value":"649"},{"groupId":"BG001","value":"156"},{"groupId":"BG002","value":"805"}]},{"title":">=65 years","measurements":[{"groupId":"BG000","value":"245"},{"groupId":"BG001","value":"67"},{"groupId":"BG002","value":"312"}]}]}]},{"title":"Age, Continuous","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"years","classes":[{"categories":[{"measurements":[{"groupId":"BG000","value":"56.8","spread":"12.51"},{"groupId":"BG001","value":"58.1","spread":"11.83"},{"groupId":"BG002","value":"57.0","spread":"12.38"}]}]}]},{"title":"Sex: Female, Male","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"Female","measurements":[{"groupId":"BG000","value":"515"},{"groupId":"BG001","value":"125"},{"groupId":"BG002","value":"640"}]},{"title":"Male","measurements":[{"groupId":"BG000","value":"379"},{"groupId":"BG001","value":"98"},{"groupId":"BG002","value":"477"}]}]}]},{"title":"Region of Enrollment","paramType":"NUMBER","unitOfMeasure":"participants","classes":[{"title":"North America","categories":[{"measurements":[{"groupId":"BG000","value":"684"},{"groupId":"BG001","value":"170"},{"groupId":"BG002","value":"854"}]}]},{"title":"Europe","categories":[{"measurements":[{"groupId":"BG000","value":"210"},{"groupId":"BG001","value":"53"},{"groupId":"BG002","value":"263"}]}]}]}]},"outcomeMeasuresModule":{"outcomeMeasures":[{"type":"PRIMARY","title":"Number of Participants With Treatment-emergent Adverse Events (TEAE)","description":"The number of participants who reported a TEAE during the treatment period. TEAE was defined as any adverse event that started or worsened on or after the start of the study medication and up to 3 days after the discontinuation of the study medication.","populationDescription":"Safety analysis set (All randomized participants who took at least one dose of study medication).","reportingStatus":"POSTED","paramType":"NUMBER","unitOfMeasure":"Participants","