"2.664"},{"groupId":"OG001","value":"-3.14","spread":"2.409"}]}]}]}]},"adverseEventsModule":{"frequencyThreshold":"5","eventGroups":[{"id":"EG000","title":"Tapentadol (CG5503)","description":"Tapentadol (CG5503) extended release (ER) 100 to 250mg twice daily (BID) for up to one year","seriousNumAffected":49,"seriousNumAtRisk":894,"otherNumAffected":766,"otherNumAtRisk":894},{"id":"EG001","title":"Oxycodone","description":"Oxycodone controlled release (CR) 20 to 50mg twice daily (BID) for up to one year.","seriousNumAffected":9,"seriousNumAtRisk":223,"otherNumAffected":202,"otherNumAtRisk":223}],"seriousEvents":[{"term":"Atrial Fibrillation","organSystem":"Cardiac disorders","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":3,"numAtRisk":894},{"groupId":"EG001","numAffected":0,"numAtRisk":223}]},{"term":"Acute myocardial infarction","organSystem":"Cardiac disorders","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":894},{"groupId":"EG001","numAffected":0,"numAtRisk":223}]},{"term":"Angina Pectoris","organSystem":"Cardiac disorders","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":894},{"groupId":"EG001","numAffected":0,"numAtRisk":223}]},{"term":"Cardiac Failure Congestive","organSystem":"Cardiac disorders","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":894},{"groupId":"EG001","numAffected":0,"numAtRisk":223}]},{"term":"Coronary Artery Disease","organSystem":"Cardiac disorders","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":894},{"groupId":"EG001","numAffected":0,"numAtRisk":223}]},{"term":"Myocardial Infarction","organSystem":"Cardiac disorders","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":894},{"groupId":"EG001","numAffected":0,"numAtRisk":223}]},{"term":"Ventricular