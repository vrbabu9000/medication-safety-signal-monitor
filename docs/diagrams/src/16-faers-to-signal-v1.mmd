    F0 --> F1 --> F2 --> F3
  end
  subgraph L["LIST 2 · What the label says (DailyMed + LLM = Part B)"]
    direction TB
    L0["Label setid 27f15fac v14<br/>4 sections: Boxed · Contraindications ·<br/>Warnings & Precautions · Adverse Reactions"]
    L1["LLM reads text → one row per reaction<br/>term · MedDRA term · section · quote"]
    L2["Grounding check: quote must exist in label<br/>Gold set check: F1 ≥ 0.85"]
    L3["= LabeledReaction<br/>Nausea ✓ · Pancreatitis acute ✓ · Alopecia ✓<br/>NOT 'blurred vision' (low-sugar symptom)"]
