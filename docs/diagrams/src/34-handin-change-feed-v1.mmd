  subgraph IN["Inputs (this build)"]
    RC["<b>Recalls</b><br/>report date · termination date<br/>status · class"]:::pipeline
    LB["<b>Labels</b><br/>version effective date"]:::pipeline
    SG["<b>Signals</b><br/>label status · ranked<br/>bucket · caution"]:::pipeline
  end

  subgraph A["A · Dated by the source: real history on day 1"]
    SD["<b>found_by = source_date</b><br/>900 recalls reported<br/>767 recalls terminated<br/>1,231 label versions effective"]:::pipeline
  end

  subgraph B["B · Found by comparing builds"]
