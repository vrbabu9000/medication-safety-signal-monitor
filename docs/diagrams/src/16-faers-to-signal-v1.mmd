flowchart LR
  subgraph F["LIST 1 · What people report (FAERS, plain code)"]
    direction TB
    F0["Report 14891719<br/>4 drugs × 2 reactions<br/>Ozempic (suspect) · Humalog (suspect)<br/>metformin · Invokana (concomitant)<br/>Hypoglycaemia · Road traffic accident"]
