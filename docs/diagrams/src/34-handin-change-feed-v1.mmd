  SS["<b>ontology_source_status</b><br/>as-of per source<br/>FAERS: through 2026Q2<br/>openFDA: updated 2026-10-28<br/>DailyMed: newest 2026-10-30<br/>RxNorm: release 02-Nov-2026"]:::pipeline
  OCE["<b>MSSM Change Event</b>"]:::ontology
  OSS["<b>MSSM Source Status</b>"]:::ontology
  P3["<b>3 · What changed</b><br/>filters: drug · event date<br/>(start date = since my last review)<br/>· entity type · change"]:::app
